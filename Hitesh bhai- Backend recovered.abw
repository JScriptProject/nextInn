<p xid="667"><c props="bgcolor:c0c0c0">userSchema.method.createAccessToken=()=&gt;{</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="668"><c props="bgcolor:c0c0c0"></c><c></c></p>
<p xid="670"><c props="bgcolor:c0c0c0">jwt.sign({</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="671"><c props="bgcolor:c0c0c0"> _id: this.id,</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="673"><c props="bgcolor:c0c0c0">email:this.email,</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="675"><c props="bgcolor:c0c0c0">name:this.name,</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="672"><c props="bgcolor:c0c0c0"></c><c props="bgcolor:c0c0c0">},</c></p>
<p xid="679"><c props="bgcolor:c0c0c0"></c><c></c></p>
<p xid="680"><c props="bgcolor:c0c0c0"></c><c props="bgcolor:c0c0c0">process.env.ACCESS_TOKEN_SECRET,</c></p>
<p xid="681"><c props="bgcolor:c0c0c0"></c><c></c></p>
<p xid="682"><c props="bgcolor:c0c0c0"></c><c props="bgcolor:c0c0c0">{</c></p>
<p xid="677"><c props="bgcolor:c0c0c0">expiresIn: “1d”</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="678"><c props="bgcolor:c0c0c0"></c><c props="bgcolor:c0c0c0">})</c></p>
<p xid="669"><c props="bgcolor:c0c0c0"></c><c props="bgcolor:c0c0c0">}</c></p>
<p xid="683"><c></c><c></c></p>
<p xid="684" props="left-shadow-color:grey; right-space:0.02in; toc-label-type1:numeric; toc-label-type2:numeric; toc-label-type3:numeric; toc-label-type4:numeric; border-shadow-merge:0; toc-label-inherits1:1; text-folded:0; top-shadow:0; list-decimal:.; bot-space:0.02in; margin-left:0pt; top-space:0.02in; bot-shadow:0; right-shadow:0; toc-has-label1:1; orphans:2; toc-page-type4:numeric; toc-tab-leader3:dot; toc-label-inherits3:1; shading-pattern:0; toc-heading:Contents; text-indent:0in; toc-source-style1:Heading 1; toc-source-style2:Heading 2; toc-source-style3:Heading 3; widows:2; toc-tab-leader1:dot; margin-right:0pt; toc-label-inherits2:1; toc-tab-leader4:dot; toc-label-inherits4:1; toc-page-type2:numeric; keep-with-next:no; toc-indent1:0.5in; toc-indent2:0.5in; text-folded-id:0; toc-indent4:0.5in; list-tag:0; top-shadow-color:grey; margin-top:0pt; text-align:left; toc-page-type1:numeric; line-height:1.0; toc-page-type3:numeric; toc-has-label2:1; toc-has-label3:1; toc-has-label4:1; toc-tab-leader2:dot; border-merge:0; margin-bottom:0pt; default-tab-interval:0.5in; toc-label-start1:1; toc-label-start2:1; right-shadow-color:grey; toc-dest-style1:Contents 1; toc-source-style4:Heading 4; shading-foreground-color:white; toc-has-heading:1; list-delim:%L; start-value:1; left-shadow:0; bot-shadow-color:grey; toc-heading-style:Contents Header; left-space:0.02in; toc-label-start3:1; toc-label-start4:1; toc-dest-style2:Contents 2; toc-dest-style3:Contents 3; toc-dest-style4:Contents 4; keep-together:no; shading-background-color:white; dom-dir:ltr; format:%*%d.; toc-indent3:0.5in"><c props="width:0in; font-family:Times New Roman; display:inline; font-variant:normal; font-weight:normal; lang:-none-; font-style:normal; text-transform:none; list-style:None; color:000000; bgcolor:ffff00; font-size:12pt; homogeneous:1; text-decoration:none; height:0in; text-position:normal; font-stretch:normal">Create refresh token</c><c props="width:0in; font-family:Times New Roman; display:inline; font-variant:normal; font-weight:normal; lang:-none-; font-style:normal; text-transform:none; list-style:None; color:000000; bgcolor:ffff00; font-size:12pt; homogeneous:1; text-decoration:none; height:0in; text-position:normal; font-stretch:normal"></c></p>
<p xid="652"><c></c><c></c></p>
<p xid="688">Create a refresh token same as above</p>
<p xid="689"><c></c><c></c></p>
<p xid="687"><c></c>-----------------------------------------------------------------</p>
<p xid="221" props="left-shadow-color:grey; right-space:0.02in; toc-label-type1:numeric; toc-label-type2:numeric; toc-label-type3:numeric; toc-label-type4:numeric; border-shadow-merge:0; toc-label-inherits1:1; text-folded:0; top-shadow:0; list-decimal:.; bot-space:0.02in; margin-left:0pt; top-space:0.02in; bot-shadow:0; right-shadow:0; toc-has-label1:1; orphans:2; toc-page-type4:numeric; toc-tab-leader3:dot; toc-label-inherits3:1; shading-pattern:0; toc-heading:Contents; text-indent:0in; toc-source-style1:Heading 1; toc-source-style2:Heading 2; toc-source-style3:Heading 3; widows:2; toc-tab-leader1:dot; margin-right:0pt; toc-label-inherits2:1; toc-tab-leader4:dot; toc-label-inherits4:1; toc-page-type2:numeric; keep-with-next:no; toc-indent1:0.5in; toc-indent2:0.5in; text-folded-id:0; toc-indent4:0.5in; list-tag:0; top-shadow-color:grey; margin-top:0pt; text-align:left; toc-page-type1:numeric; line-height:1.0; toc-page-type3:numeric; toc-has-label2:1; toc-has-label3:1; toc-has-label4:1; toc-tab-leader2:dot; border-merge:0; margin-bottom:0pt; default-tab-interval:0.5in; toc-label-start1:1; toc-label-start2:1; right-shadow-color:grey; toc-dest-style1:Contents 1; toc-source-style4:Heading 4; shading-foreground-color:white; toc-has-heading:1; list-delim:%L; start-value:1; left-shadow:0; bot-shadow-color:grey; toc-heading-style:Contents Header; left-space:0.02in; toc-label-start3:1; toc-label-start4:1; toc-dest-style2:Contents 2; toc-dest-style3:Contents 3; toc-dest-style4:Contents 4; keep-together:no; shading-background-color:white; dom-dir:ltr; format:%*%d.; toc-indent3:0.5in"><c props="width:0in; font-family:Times New Roman; display:inline; font-variant:normal; font-weight:normal; lang:-none-; font-style:normal; text-transform:none; list-style:None; color:000000; bgcolor:ffff00; font-size:12pt; homogeneous:1; text-decoration:none; height:0in; text-position:normal; font-stretch:normal">mongoose-aggregate-paginate-v2</c><c props="width:0in; font-family:Times New Roman; display:inline; font-variant:normal; font-weight:normal; lang:-none-; font-style:normal; text-transform:none; list-style:None; color:000000; bgcolor:ffff00; font-size:12pt; homogeneous:1; text-decoration:none; height:0in; text-position:normal; font-stretch:normal"></c></p>
<p xid="222"><c></c><c></c></p>
<p xid="690"><c></c>Need to install above package if we fetch the bulk data</p>
<p xid="691"><c></c><c></c></p>
<p xid="224"><c></c><c></c></p>
<p xid="692"><c></c><c props="font-weight:bold">Use Case</c>-</p>
<p xid="693"><c></c><c></c></p>
<p xid="226">Suppose you have 1000 users in your MongoDB collection.<c></c></p>
<p xid="227">Without pagination:<c></c></p>
<p xid="228">GET /users<c></c></p>
<p xid="229">[<c></c></p>
<p xid="230">{ "id": 1, "name": "Ravi" },<c></c></p>
<p xid="231">{ "id": 2, "name": "John" },<c></c></p>
<p xid="232">...<c></c></p>
<p xid="233">{ "id": 1000, "name": "Alex" }<c></c></p>
<p xid="234">]<c></c></p>
<p xid="235">This would send all 1000 records at once (slow + heavy for client)<c></c></p>
<p xid="238"><c></c><c></c></p>
<p xid="694"><c></c>with pagination</p>
<p xid="239">limit = 10  per page<c></c></p>
<p xid="695"><c></c><c></c></p>
<p xid="242">GET/users? page=1 &amp; limit=10<c></c></p>
<p xid="696"><c></c><c></c></p>
<p xid="243">response from database would be as below<c></c></p>
<p xid="244"><c></c><c></c></p>
<p xid="697"><c></c>"docs": [</p>
<p xid="245">{ "id": 10, "name": "Alex" }<c></c></p>
<p xid="246">],<c></c></p>
<p xid="247">"page": 1,<c></c></p>
<p xid="248">"totalPages": 100<c></c></p>
<p xid="249"><c></c><c></c></p>
<p xid="698"><c></c>Client get 10 users at a time and if required client can request for more.</p>
<p xid="250"><c></c><c></c></p>
<p xid="699"><c></c>Perfomance</p>
<p xid="251"><c></c><c></c></p>
<p xid="701">=&gt; Pagination improve prformance and dont overload server or client with huge data dump.<c></c></p>
<p xid="252">Faster Loading<c></c></p>
<p xid="253"><c></c><c></c></p>
<p xid="700">=&gt; Only some part of data being fetched<c></c></p>
<p xid="254">Better UX<c></c></p>
<p xid="255"><c></c><c></c></p>
<p xid="702">=&gt; User scrolls or click “ next page” instead of waiting for evrything.<c></c></p>
<p xid="256"><c></c><c></c></p>
<p xid="703"><c></c>Pagination = breaking result into pages, this package helps us to do that for mongoDB aggtregative queries.</p>
<p xid="257"><c></c><c></c></p>
<p xid="704"><c></c><c props="font-weight:bold">How to use in model.</c></p>
<p xid="258"><c></c><c></c></p>
<p xid="705"><c></c>Suppose we have video model, where we will have multiple videos stored so we will use</p>
<p xid="259"><c></c><c></c></p>
<p xid="707"><c></c>mongoose-aggregate-paginate-v2 in this model.</p>
<p xid="260"><c></c><c></c></p>
<p xid="706"><c></c><c props="font-weight:bold">//code as below</c></p>
<p xid="261"><c props="bgcolor:c0c0c0">import mongoose, { Schema } from "mongoose";</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="262"><c props="bgcolor:c0c0c0">import mongooseAggregatePaginate from "mongoose-aggregate-paginate-v2";</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="263"><c props="bgcolor:c0c0c0">const videoSchema = new Schema({},{});</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="264"><c props="bgcolor:c0c0c0">videoSchema.plugin(mongooseAggregatePaginate);</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="265"><c props="bgcolor:c0c0c0">export const Video = mongoose.model(“Video”, videoSchema)</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="717"><c></c><c></c></p>
<p xid="266">***********************************************<c></c></p>
