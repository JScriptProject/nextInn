<section footer="1" header="0" xid="4">
<p xid="5"><c props="font-weight:bold; font-size:26pt">Initial Setup for fullstack application</c><c props="font-weight:bold; font-size:26pt"></c></p>
<p xid="1"><c></c><c></c></p>
<p xid="6"><c props="bgcolor:ff80c0; font-weight:bold; font-size:18pt">1. package.json</c><c props="bgcolor:ff80c0; font-weight:bold; font-size:18pt"></c></p>
<p xid="3">start with npm init -y<c></c></p>
<p xid="2"><c></c><c></c></p>
<p xid="7">- create folder as below<c></c></p>
<p xid="8">- public<c></c></p>
<p xid="9">     - temp<c></c></p>
<p xid="510">----------------</p>
<p xid="10">- src</p>
<p xid="498">   - constrollers</p>
<p xid="499">   - middlewares</p>
<p xid="500">   - models</p>
<p xid="501">   - db</p>
<p xid="502">   - router</p>
<p xid="503">   - util</p>
<p xid="504">   app.js</p>
<p xid="505">   constant.js</p>
<p xid="506">   server.js</p>
<p xid="509">----------------------</p>
<p xid="492"><c></c>.gitkeep(<c props="font-weight:bold">file</c>)</p>
<p xid="11">.gitignore(<c props="font-weight:bold">file</c><c props="font-weight:bold"></c>)</p>
<p xid="494">.env (<c props="font-weight:bold">file)</c><c props="font-weight:bold"></c></p>
<p xid="495">---------------------</p>
<p xid="511">create .gitignore</p>
<p xid="512"><c></c><c></c></p>
