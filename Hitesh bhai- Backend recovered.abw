<p xid="114">index.js<c></c></p>
<p xid="115"><c props="bgcolor:c0c0c0">import {connectDB} from ‘./db/index.js’</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="116"><c props="bgcolor:c0c0c0">import app from ‘./app.js’</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="117"><c props="bgcolor:c0c0c0">ditenv.config();</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="118"><c props="bgcolor:c0c0c0">const PORT = process.env.PORT || 5000;</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="119"><c props="bgcolor:c0c0c0">connectDB()</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="120"><c props="bgcolor:c0c0c0">.then(()=&gt;{</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="121"><c props="bgcolor:c0c0c0">app.listen(PORT,()=&gt;{</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="122"><c props="bgcolor:c0c0c0">console.log(“Server started on port =”, PORT);})</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="123"><c props="bgcolor:c0c0c0">app.on(“error",(err)=&gt;{</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="124"><c props="bgcolor:c0c0c0">console.log(“Error while starting server: ”, err);</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="125"><c props="bgcolor:c0c0c0">}) })</c><c props="bgcolor:c0c0c0"></c></p>
<p xid="126"><c props="bgcolor:c0c0c0">.catch((error)=&gt;{console.log(“Issue with server starting:”, error); throws error;})</c><c props="bgcolor:c0c0c0"></c></p>
