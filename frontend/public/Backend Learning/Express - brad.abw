<pagesize pagetype="Letter" orientation="portrait" width="8.500000" height="11.000000" units="in" page-scale="1.000000"/>
<section xid="1" props="page-margin-footer:0.5in; page-margin-header:0.5in">
<p style="Heading 1" xid="2">EXPRESS<c></c></p>
<p style="Normal" xid="3"><c></c><c></c></p>
<p style="Normal" xid="4"><c props="font-weight:bold">Express Setup</c><c props="font-weight:bold"></c></p>
<p style="Normal" xid="5"><c></c><c></c></p>
<p style="Normal" xid="6"><c props="font-weight:bold; font-style:italic">create a package.json</c><c props="font-weight:bold; font-style:italic"></c></p>
<p style="Normal" xid="15"><c props="font-weight:normal">npm init</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="14"><c></c><c></c></p>
<p style="Normal" xid="7"><c props="font-weight:bold; font-style:italic">install express with </c><c props="font-weight:bold; font-style:italic"></c></p>
<p style="Normal" xid="9" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">npm install express --save</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="10" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="11" props="text-align:left; dom-dir:ltr"><c props="font-family:Times New Roman; text-decoration:none; color:000000; font-size:12pt; text-position:normal; font-weight:normal; font-style:normal; lang:en-US">Using the common JS practice to create a app</c><c props="font-family:Times New Roman; text-decoration:none; color:000000; font-size:12pt; text-position:normal; font-weight:normal; font-style:normal; lang:en-US"></c></p>
<p style="Normal" xid="12" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold; font-style:italic"></c><c></c></p>
<p style="Normal" xid="27" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold; font-style:italic"></c><c props="font-weight:bold; font-style:italic">Create a express app</c></p>
<p style="Normal" xid="19" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">const express = require(‘express’);</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="20" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c props="font-weight:normal; font-style:normal">const app = express();</c></p>
<p style="Normal" xid="22" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="23" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold; font-style:italic">simple routing</c><c props="font-weight:bold; font-style:italic"></c></p>
<p style="Normal" xid="28" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:normal">app.get(“/about”,(req,res)=&gt;{res.send(“About Page”)})</c><c props="font-style:normal; font-weight:normal"></c></p>
<p style="Normal" xid="29" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:normal"></c><c></c></p>
<p style="Normal" xid="24" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold; font-style:italic">start the server</c><c props="font-weight:bold; font-style:italic"></c></p>
<p style="Normal" xid="25" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:normal">app.listen(5000, ()=&gt;{Console.log(“Server started”)})</c><c props="font-style:normal; font-weight:normal"></c></p>
<p style="Normal" xid="30" props="text-align:left; dom-dir:ltr"><c props="font-style:italic; font-weight:normal"></c><c></c></p>
<p style="Heading 1" xid="31" props="text-align:left; dom-dir:ltr"><c props="font-style:italic"></c><c props="font-style:normal">static folder/ static assets</c></p>
<p style="Normal" xid="136" props="text-align:left; dom-dir:ltr"><c props="font-style:normal"></c><c></c></p>
<p style="Normal" xid="32" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:italic">We can create a static files on the server on specific folder and server that as static assets</c><c props="font-weight:normal; font-style:italic"></c></p>
<p style="Normal" xid="33" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:italic"></c><c></c></p>
<p style="Normal" xid="34" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:italic">IMP - Use the absolute path</c><c props="font-weight:normal; font-style:italic"></c></p>
<p style="Normal" xid="35" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:italic"></c><c></c></p>
<p style="Normal" xid="37" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">const __filename = fileURLToPath(import.meta.url);</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="38" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">const __dirname = path.dirname(__filename);</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="39" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold; font-style:italic"></c><c></c></p>
<p style="Normal" xid="41" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:bold">Suppose we have created a files under the folder public</c><c props="font-style:normal; font-weight:bold"></c></p>
<p style="Normal" xid="43" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:bold"></c><c></c></p>
<p style="Normal" xid="44" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:bold">public -</c><c props="font-style:normal; font-weight:bold"></c></p>
<p style="Normal" xid="45" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:bold">       - index.html    </c><c props="font-style:normal; font-weight:bold"></c><c props="font-weight:normal; font-style:normal"> </c><c props="font-weight:bold; font-style:normal">-</c><c props="font-weight:normal; font-style:normal"> http://localhost:5000/</c></p>
<p style="Normal" xid="46" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:bold">       - about.html    - </c><c props="font-style:normal; font-weight:bold"></c><c props="font-family:Times New Roman; text-decoration:none; color:000000; font-size:12pt; text-position:normal; font-weight:normal; font-style:normal; lang:en-US">http://localhost:5000/about.html</c><c props="font-style:normal; font-weight:bold"> </c></p>
<p style="Normal" xid="47" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:bold">       - contact.html  - </c><c props="font-style:normal; font-weight:bold"></c><c props="font-family:Times New Roman; text-decoration:none; color:000000; font-size:12pt; text-position:normal; font-weight:normal; font-style:normal; lang:en-US">http://localhost:5000/conatct.html</c></p>
<p style="Normal" xid="40" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:italic"></c><c></c></p>
<p style="Normal" xid="36" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:italic"></c><c></c></p>
<p style="Normal" xid="26" props="text-align:left; dom-dir:ltr"><c props="font-style:normal; font-weight:normal">app.use(express.static(path.join(__dirname,'public’))));</c><c props="font-style:normal; font-weight:normal"></c></p>
<p style="Normal" xid="13" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 1" xid="48" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 1" xid="54" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 1" xid="55" props="text-align:left; dom-dir:ltr"><c></c>Dealing with 404 route</p>
<p style="Normal" xid="49" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="50" props="text-align:left; dom-dir:ltr">// 404 not found route<c></c></p>
<p style="Normal" xid="51" props="text-align:left; dom-dir:ltr">app.use((req, res)=&gt;{<c></c></p>
<p style="Normal" xid="52" props="text-align:left; dom-dir:ltr">    res.status(404).send("404 Route not found");<c></c></p>
<p style="Normal" xid="53" props="text-align:left; dom-dir:ltr">})<c></c></p>
<p style="Normal" xid="56" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="57" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 2" xid="58" props="text-align:left; dom-dir:ltr">JSON response<c></c></p>
<p style="Normal" xid="59" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="66" props="text-align:left; dom-dir:ltr">const posts = [{id:1, title:"post 1”}, <c></c><c props="font-family:Times New Roman; text-decoration:none; color:000000; font-size:12pt; text-position:normal; font-weight:normal; font-style:normal; lang:en-US">{id:2, title:"post 2”}</c>]</p>
<p style="Normal" xid="65" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="60" props="text-align:left; dom-dir:ltr">prefer to send json response like below<c></c></p>
<p style="Normal" xid="61" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="62" props="text-align:left; dom-dir:ltr">app.get(“/api/posts”, (req, res)=&gt;{<c></c></p>
<p style="Normal" xid="63" props="text-align:left; dom-dir:ltr">  res.<c></c><c props="font-weight:bold">json</c>(posts);</p>
<p style="Normal" xid="64" props="text-align:left; dom-dir:ltr"><c></c>})</p>
<p style="Normal" xid="67" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 2" xid="68" props="text-align:left; dom-dir:ltr">dot env<c></c></p>
<p style="Normal" xid="71" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="72" props="text-align:left; dom-dir:ltr">no need dotenv package instead do thing <c></c></p>
<p style="Normal" xid="73" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="74" props="text-align:left; dom-dir:ltr">package.json--<c></c></p>
<p style="Normal" xid="75" props="text-align:left; dom-dir:ltr">“dev”:"node --watch --env-file=.env index.js<c></c></p>
<p style="Normal" xid="69" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 1" xid="70" props="text-align:left; dom-dir:ltr">request param<c></c></p>
<p style="Normal" xid="76" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="77" props="text-align:left; dom-dir:ltr">//get specific post<c></c></p>
<p style="Normal" xid="78" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="79" props="text-align:left; dom-dir:ltr">app.get('/api/posts/<c></c><c props="font-weight:bold">:id</c>', (req, res) =&gt;{</p>
<p style="Normal" xid="80" props="text-align:left; dom-dir:ltr">    const paramId = <c></c><c props="font-weight:bold">req.params.id</c>;</p>
<p style="Normal" xid="81" props="text-align:left; dom-dir:ltr">    console.log(paramId);<c></c></p>
<p style="Normal" xid="82" props="text-align:left; dom-dir:ltr">    const data = posts.filter((post)=&gt; post.id === parseInt(paramId));<c></c></p>
<p style="Normal" xid="83" props="text-align:left; dom-dir:ltr">    res.json(data);<c></c></p>
<p style="Normal" xid="84" props="text-align:left; dom-dir:ltr">})<c></c></p>
<p style="Normal" xid="85" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="86" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="87" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="88" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="89" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 1" xid="90" props="text-align:left; dom-dir:ltr">Query String</p>
<p style="Normal" xid="91" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="93" props="text-align:left; dom-dir:ltr">http://localhost:5000/api/posts?<c props="font-weight:bold; bgcolor:ff00ff">limit=2</c><c props="font-weight:bold; bgcolor:ff00ff"></c>&amp;<c props="font-weight:bold; bgcolor:ff00ff">sort=desc</c>&amp;<c props="font-weight:bold; bgcolor:ff00ff">page=2</c></p>
<p style="Normal" xid="96" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="97" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold">Def</c><c props="font-weight:bold"></c>- Query string is the part of the URL which comes after ? It lets you pass the extra dta to server without changing the route itself.</p>
<p style="Normal" xid="98" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="99" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="100" props="text-align:left; dom-dir:ltr"><c props="font-style:italic">Handle query string in same route. </c><c props="font-style:italic"></c></p>
<p style="Normal" xid="101" props="text-align:left; dom-dir:ltr"><c props="font-style:italic"></c><c></c></p>
<p style="Normal" xid="102" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">app.get(“/api/posts”, (req, res)=&gt;{</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="103" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">const limit = req.query.limit;</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="105" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="106" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">if(!NaN(limit) &amp;&amp; limit &gt;0)</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="107" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">{</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="108" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">  res.json(posts.slice(0, limit));</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="109" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c props="font-weight:normal; font-style:normal">}</c></p>
<p style="Normal" xid="110" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">else</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="112" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">{</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="113" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">  res.json(posts);</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="114" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c props="font-weight:normal; font-style:normal">}</c></p>
<p style="Normal" xid="104" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c props="font-weight:normal; font-style:normal">})</c></p>
<p style="Normal" xid="115" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="116" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="117" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Heading 1" xid="118" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold">Setting status code</c><c props="font-weight:bold"></c></p>
<p style="Normal" xid="121" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="122" props="text-align:left; dom-dir:ltr">status code range <c></c></p>
<p style="Normal" xid="124" props="text-align:left; dom-dir:ltr">200 - success<c></c></p>
<p style="Normal" xid="125" props="text-align:left; dom-dir:ltr">300 - redirect<c></c></p>
<p style="Normal" xid="126" props="text-align:left; dom-dir:ltr">400 - client error<c></c></p>
<p style="Normal" xid="127" props="text-align:left; dom-dir:ltr">500 - server error<c></c></p>
<p style="Normal" xid="128" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="129" props="text-align:left; dom-dir:ltr">res.status(200).json(data);<c></c></p>
<p style="Normal" xid="130" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="131" props="text-align:left; dom-dir:ltr">res.status(201).send(newdata);<c></c></p>
<p style="Normal" xid="132" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 1" xid="135" props="text-align:left; dom-dir:ltr">Express Route<c></c></p>
<p style="Normal" xid="120" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="119" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="137" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">we can create a route be seperating the route files in diff folder</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="138" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="139" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">route</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="140" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal">    - customerRoute.js</c><c props="font-weight:normal; font-style:normal"></c></p>
<p style="Normal" xid="141" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="142" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
<p style="Normal" xid="143" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal; font-style:normal"></c><c></c></p>
