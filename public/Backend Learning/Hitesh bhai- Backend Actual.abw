<section xid="1" props="page-margin-footer:0.5in; page-margin-header:0.5in">
<p style="Heading 2" xid="2">.gitkeep<c></c></p>
<p style="Normal" xid="3"><c></c><c></c></p>
<p style="Normal" xid="4">- create folder as below<c></c></p>
<p style="Normal" xid="6"> - public<c></c></p>
<p style="Normal" xid="7">   - temp<c></c></p>
<p style="Normal" xid="8">     - .gitkeep<c></c></p>
<p style="Normal" xid="9"><c></c><c></c></p>
<p style="Normal" xid="10"><c></c><c></c></p>
<p style="Heading 2" xid="11">.gitignore<c></c></p>
<p style="Normal" xid="13"><c></c><c></c></p>
<p style="Normal" xid="14" props="text-align:left; dom-dir:ltr">https://mrkandreev.name/snippets/gitignore-generator/<c></c></p>
<p style="Normal" xid="15" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 2" xid="16" props="text-align:left; dom-dir:ltr">.env<c></c></p>
<p style="Normal" xid="18" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Heading 2" xid="19" props="text-align:left; dom-dir:ltr">src folder<c></c></p>
<p style="Normal" xid="20" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="21" props="text-align:left; dom-dir:ltr">create the below mentioed files below src<c></c></p>
<p style="Normal" xid="22" props="text-align:left; dom-dir:ltr">- app.js<c></c></p>
<p style="Normal" xid="23" props="text-align:left; dom-dir:ltr">-constant.js<c></c></p>
<p style="Normal" xid="24" props="text-align:left; dom-dir:ltr">-index.js<c></c></p>
<p style="Normal" xid="25" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="26" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="27" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold">Package.json. edit</c><c props="font-weight:bold"></c></p>
<p style="Normal" xid="28" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="29" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">type: module</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="30" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="31" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold">install nodemon</c><c props="font-weight:bold"></c></p>
<p style="Normal" xid="32" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold"></c><c></c></p>
<p style="Normal" xid="33" props="text-align:left; dom-dir:ltr"><c props="font-weight:bold">---------------------</c><c props="font-weight:bold"></c></p>
<p style="Normal" xid="35" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">Create below mentioned folders under src</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="36" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">-controllers</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="37" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">-midlewares</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="38" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">-models</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="39" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">-routes</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="40" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">-utils</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="41" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">-db</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="42" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal"></c><c></c></p>
<p style="Normal" xid="43" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">---------------</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="45" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">install prettier</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="46" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal"></c><c></c></p>
<p style="Normal" xid="47" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">npm i prettier</c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="48" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal"></c><c></c></p>
<p style="Normal" xid="49" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal">and create a prettier config file in home directory </c><c props="font-weight:normal"></c></p>
<p style="Normal" xid="50" props="text-align:left; dom-dir:ltr"><c props="font-weight:normal"></c><c></c></p>
<p style="Normal" xid="51" props="text-align:left; dom-dir:ltr">.prettierrc<c></c></p>
<p style="Normal" xid="12"><c></c><c></c></p>
<p style="Normal" xid="52">mentioed below configuration in .prettierrc<c></c></p>
<p style="Normal" xid="53"><c></c><c></c></p>
<p style="Normal" xid="54">{<c></c></p>
<p style="Normal" xid="55" props="text-align:left; dom-dir:ltr">    "singleQuote": false,<c></c></p>
<p style="Normal" xid="56" props="text-align:left; dom-dir:ltr">    "bracketSpacing": true,<c></c></p>
<p style="Normal" xid="57" props="text-align:left; dom-dir:ltr">    "tabWidth": 2,<c></c></p>
<p style="Normal" xid="58" props="text-align:left; dom-dir:ltr">    "semi": true,<c></c></p>
<p style="Normal" xid="59" props="text-align:left; dom-dir:ltr">    "trailingComma": "es5"<c></c></p>
<p style="Normal" xid="60" props="text-align:left; dom-dir:ltr">  <c></c></p>
<p style="Normal" xid="61" props="text-align:left; dom-dir:ltr">}<c></c></p>
<p style="Normal" xid="62" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="63" props="text-align:left; dom-dir:ltr">----------------------------------------<c></c></p>
<p style="Normal" xid="64" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="65" props="text-align:left; dom-dir:ltr">Also create a .prettierignore file <c></c></p>
<p style="Normal" xid="66" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="67" props="text-align:left; dom-dir:ltr">mentioned below in same . <c></c></p>
<p style="Normal" xid="68" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
<p style="Normal" xid="69" props="text-align:left; dom-dir:ltr">/.vscode<c></c></p>
<p style="Normal" xid="70" props="text-align:left; dom-dir:ltr">/node_modules<c></c></p>
<p style="Normal" xid="71" props="text-align:left; dom-dir:ltr">./dist<c></c></p>
<p style="Normal" xid="72" props="text-align:left; dom-dir:ltr"><c></c><c></c></p>
